def create_controller(
    handlers: dict[str, Any],
):

    if execution_controller is None:
        return None

    Controller = getattr(
        execution_controller,
        "ExecutionController",
        None,
    )

    if Controller is None:
        return None

    try:
        return Controller(
            handlers=handlers
        )

    except TypeError:

        try:
            controller = Controller()

            register_many = getattr(
                controller,
                "register_many",
                None,
            )

            if callable(register_many):
                register_many(
                    handlers
                )

            return controller

        except Exception as exc:

            log(
                "CONTROLLER INIT ERROR: "
                + repr(exc)
            )

            return None

    except Exception as exc:

        log(
            "CONTROLLER INIT ERROR: "
            + repr(exc)
        )

        return None


