def clean_text(value: Any) -> str:

    if value is None:
        return ""

    text = str(value)

    text = text.replace(
        "\x00",
        " ",
    )

    text = text.replace(
        "\r\n",
        "\n",
    )

    text = text.replace(
        "\r",
        "\n",
    )

    text = re.sub(
        r"[ \t]+",
        " ",
        text,
    )

    return text.strip()


def normalize_text(text: str) -> str:

    text = clean_text(text)

    if not text:
        return ""

    replacements = {
        "mấy h": "mấy giờ",
        "may h": "mấy giờ",
        "mấy g": "mấy giờ",
        "may g": "mấy giờ",
        "hnay": "hôm nay",
        "hom nay": "hôm nay",
        "iphonee": "iphone",
    }

    lowered = text.lower()

    for old, new in replacements.items():

        lowered = re.sub(
            rf"(?<!\w){re.escape(old)}(?!\w)",
            new,
            lowered,
        )

    return lowered.strip()


