def build_chat_context(
    limit: int = 10,
) -> str:

    messages = HISTORY[-limit:]

    lines = []

    for item in messages:

        role = clean_text(
            item.get(
                "role",
                "",
            )
        )

        content = clean_text(
            item.get(
                "content",
                "",
            )
        )

        if not content:
            continue

        if role == "user":
            label = "Lam"

        elif role == "assistant":
            label = "Minh"

        else:
            label = role or "System"

        lines.append(
            f"{label}: {content}"
        )

    return "\n".join(lines)


