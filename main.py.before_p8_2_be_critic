def handle_action(
    message: str,
    decision: Any = None,
    **kwargs: Any,
) -> str:

    if action is None:
        return (
            "Module điều khiển máy chưa được tải."
        )

    try:

        handler = getattr(
            action,
            "handle_action_command",
            None,
        )

        if not callable(handler):
            handler = getattr(
                action,
                "execute_action",
                None,
            )

        if not callable(handler):
            handler = getattr(
                action,
                "execute",
                None,
            )

        if not callable(handler):
            return (
                "Module action chưa có hàm thực thi."
            )

        action_name = ""
        target = ""
        query = ""

        if decision is not None:

            action_name = clean_text(
                get_decision_value(
                    decision,
                    "action",
                    "",
                )
            )

            target = clean_text(
                get_decision_value(
                    decision,
                    "target",
                    "",
                )
            )

            query = clean_text(
                get_decision_value(
                    decision,
                    "query",
                    "",
                )
            )

        result = handler(
            command=message,
            action=action_name,
            target=target,
            query=query,
        )

        return normalize_execution_response(
            result
        )

    except TypeError:

        try:

            result = handler(message)

            return normalize_execution_response(
                result
            )

        except Exception as exc:

            log(
                "ACTION ERROR: "
                + traceback.format_exc()
            )

            return (
                f"Minh không thực hiện được hành động: {exc}"
            )

    except Exception as exc:

        log(
            "ACTION ERROR: "
            + traceback.format_exc()
        )

        return (
            f"Minh không thực hiện được hành động: {exc}"
        )


# ============================================================
# DECISION HELPERS
# ============================================================

def get_decision_value(
    decision: Any,
    name: str,
    default: Any = None,
) -> Any:

    if decision is None:
        return default

    if isinstance(
        decision,
        dict,
    ):
        return decision.get(
            name,
            default,
        )

    return getattr(
        decision,
        name,
        default,
    )


def normalize_execution_response(
    value: Any,
) -> str:

    if value is None:
        return ""

    if isinstance(
        value,
        str,
    ):
        return clean_text(value)

    response = get_decision_value(
        value,
        "response",
        "",
    )

    if response:
        return clean_text(
            response
        )

    success = get_decision_value(
        value,
        "success",
        None,
    )

    error = get_decision_value(
        value,
        "error",
        "",
    )

    if success is False and error:
        return clean_text(
            error
        )

    return clean_text(
        str(value)
    )


# ============================================================
# MEMORY HANDLER
# ============================================================

def handle_memory(
    message: str,
    decision: Any = None,
    **kwargs: Any,
) -> str:

    text = clean_text(message)
    lower = text.lower()

    # --------------------------------------------------------
    # Remember
    # --------------------------------------------------------

    remember_patterns = (
        "nhớ ",
        "ghi nhớ ",
        "lưu lại ",
        "hãy nhớ ",
        "nhớ rằng ",
    )

    for pattern in remember_patterns:

        if lower.startswith(pattern):

            content = text[
                len(pattern):
            ].strip()

            return memory_add(
                content
            )

    # --------------------------------------------------------
    # List
    # --------------------------------------------------------

    if any(
        phrase in lower
        for phrase in (
            "nhớ gì",
            "đang nhớ gì",
            "liệt kê bộ nhớ",
            "xem bộ nhớ",
            "memory",
        )
    ):
        return memory_list()

    # --------------------------------------------------------
    # Search
    # --------------------------------------------------------

    for prefix in (
        "tìm trong bộ nhớ ",
        "tìm bộ nhớ ",
        "nhớ về ",
    ):

        if lower.startswith(prefix):

            query = text[
                len(prefix):
            ].strip()

            return memory_search(
                query
            )

    return memory_list()


