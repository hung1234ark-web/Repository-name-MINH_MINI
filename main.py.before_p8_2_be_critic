MEMORY = load_memory()


def memory_add(
    text: str,
) -> str:

    text = clean_text(text)

    if not text:
        return "Minh chưa có nội dung để nhớ."

    items = MEMORY.setdefault(
        "items",
        [],
    )

    item = {
        "text": text,
        "created_at": datetime.now().isoformat(
            timespec="seconds"
        ),
    }

    items.append(item)

    max_items = int(
        CONFIG.get(
            "memory",
            {},
        ).get(
            "max_items",
            500,
        )
    )

    if len(items) > max_items:
        del items[
            : len(items) - max_items
        ]

    save_memory(MEMORY)

    return f"Minh nhớ rồi: {text}"


def memory_list() -> str:

    items = MEMORY.get(
        "items",
        [],
    )

    if not items:
        return "Hiện Minh chưa lưu điều gì."

    lines = [
        "Những điều Minh đang nhớ:"
    ]

    for index, item in enumerate(
        items[-20:],
        start=1,
    ):

        if isinstance(item, dict):
            value = item.get(
                "text",
                "",
            )
        else:
            value = str(item)

        lines.append(
            f"{index}. {value}"
        )

    return "\n".join(lines)


def memory_search(
    query: str,
) -> str:

    query = clean_text(query).lower()

    if not query:
        return memory_list()

    matches = []

    for item in MEMORY.get(
        "items",
        [],
    ):

        value = (
            item.get("text", "")
            if isinstance(item, dict)
            else str(item)
        )

        if query in value.lower():
            matches.append(value)

    if not matches:
        return (
            f"Minh chưa tìm thấy ký ức nào "
            f"liên quan đến '{query}'."
        )

    return "\n".join(
        f"{i}. {value}"
        for i, value in enumerate(
            matches,
            start=1,
        )
    )


