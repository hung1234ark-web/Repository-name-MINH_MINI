def brain_think(
    brain: Any,
    message: str,
) -> Any:

    if brain is None:

        if brain_module is None:
            return None

        functions = (
            "think",
            "resolve",
            "plan",
        )

        for name in functions:

            function = getattr(
                brain_module,
                name,
                None,
            )

            if callable(function):

                try:
                    return function(
                        message
                    )

                except TypeError:
                    try:
                        return function(
                            message=message
                        )

                    except Exception:
                        pass

                except Exception:
                    pass

        return None

    for name in (
        "think",
        "resolve",
        "plan",
    ):

        function = getattr(
            brain,
            name,
            None,
        )

        if not callable(function):
            continue

        try:

            decision = function(
                message
            )

            if decision is not None:
                return decision

        except TypeError:

            try:

                decision = function(
                    message=message
                )

                if decision is not None:
                    return decision

            except Exception:
                pass

        except Exception as exc:

            log(
                f"BRAIN {name} ERROR: "
                + repr(exc)
            )

    return None


# ============================================================
# DECISION FALLBACK
# ============================================================

def fallback_decision(
    message: str,
) -> dict[str, Any]:

    text = clean_text(message)
    lower = text.lower()

    if lower in {
        "mấy giờ",
        "mấy giờ rồi",
        "bây giờ là mấy giờ",
        "giờ hiện tại",
    }:
        return {
            "intent": "time",
            "tool": "time",
        }

    if any(
        phrase in lower
        for phrase in (
            "hôm nay là ngày bao nhiêu",
            "hôm nay ngày mấy",
            "ngày hôm nay",
        )
    ):
        return {
            "intent": "date",
            "tool": "date",
        }

    if lower.startswith(
        (
            "nhớ ",
            "ghi nhớ ",
            "lưu lại ",
            "xem bộ nhớ",
            "nhớ gì",
        )
    ):
        return {
            "intent": "memory",
            "tool": "memory",
        }

    if lower.startswith(
        (
            "tìm trên web ",
            "tìm trên mạng ",
            "tra cứu ",
            "search web ",
        )
    ):

        query = text

        for prefix in (
            "tìm trên web ",
            "tìm trên mạng ",
            "tra cứu ",
            "search web ",
        ):

            if lower.startswith(prefix):
                query = text[
                    len(prefix):
                ]
                break

        return {
            "intent": "web",
            "tool": "web",
            "query": query,
        }

    if lower.startswith("mở "):

        return {
            "intent": "action",
            "tool": "action",
            "action": "open",
            "target": text[3:].strip(),
        }

    if lower.startswith("đóng "):

        return {
            "intent": "action",
            "tool": "action",
            "action": "close",
            "target": text[5:].strip(),
        }

    if "?" in text:

        return {
            "intent": "question",
            "tool": "ollama",
        }

    return {
        "intent": "chat",
        "tool": "ollama",
    }


# ============================================================
# ROUTER
# ============================================================

def route_decision(
    message: str,
    decision: Any,
) -> Any:

    if router_guard is None:
        return decision

    guard = getattr(
        router_guard,
        "guard_route",
        None,
    )

    if not callable(guard):
        guard = getattr(
            router_guard,
            "validate_route",
            None,
        )

    if not callable(guard):
        return decision

    try:

        return guard(
            message,
            decision,
        )

    except TypeError:

        try:
            return guard(
                message=message,
                decision=decision,
            )

        except Exception:
            return decision

    except Exception as exc:

        log(
            "ROUTER ERROR: "
            + repr(exc)
        )

        return decision


# ============================================================
# CONTEXT UPDATE
# ============================================================

def update_context(
    message: str,
    answer: str,
    decision: Any,
    execution_result: Any = None,
) -> None:

    if conversation_state is None:
        return

    updater = getattr(
        conversation_state,
        "update_state",
        None,
    )

    if not callable(updater):
        return

    try:

        updater(
            message=message,
            answer=answer,
            decision=decision,
            result=execution_result,
        )

        return

    except TypeError:
        pass

    except Exception as exc:

        log(
            "CONTEXT UPDATE ERROR: "
            + repr(exc)
        )

        return

    # Compatibility fallback
    try:

        updater(
            message,
            answer,
            decision,
        )

    except Exception:
        pass


