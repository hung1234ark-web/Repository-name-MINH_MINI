# RESPONSE GUARD
# ============================================================

def guard_answer(
    message: str,
    answer: str,
    execution_result: Any = None,
    decision: Any = None,
) -> str:

    answer = clean_text(answer)

    if response_guard is None:
        return answer

    guard = getattr(
        response_guard,
        "guard_response",
        None,
    )

    if not callable(guard):
        guard = getattr(
            response_guard,
            "safe_response",
            None,
        )

    if not callable(guard):
        return answer

    try:

        return clean_text(
            guard(
                message,
                answer,
                execution_result=execution_result,
                decision=decision,
            )
        )

    except TypeError:

        try:

            return clean_text(
                guard(
                    message,
                    answer,
                )
            )

        except Exception:
            return answer

    except Exception as exc:

        log(
            "RESPONSE GUARD ERROR: "
            + repr(exc)
        )

        return answer


