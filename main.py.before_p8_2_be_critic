def handle_web(
    query: str,
    **kwargs: Any,
) -> str:

    query = clean_text(query)

    if not query:
        return (
            "Lam cần cho Minh biết nội dung muốn tìm."
        )

    if web is None:
        return (
            "Module web chưa được tải."
        )

    try:

        search_function = getattr(
            web,
            "safe_search",
            None,
        )

        if not callable(search_function):
            search_function = getattr(
                web,
                "search",
                None,
            )

        if not callable(search_function):
            return (
                "Module web chưa có hàm tìm kiếm."
            )

        results = search_function(
            query
        )

        if not results:
            return (
                f"Minh chưa tìm thấy kết quả phù hợp "
                f"cho '{query}'."
            )

        if web_ai is not None:

            summarize = getattr(
                web_ai,
                "summarize_results",
                None,
            )

            if callable(summarize):

                try:

                    summary = summarize(
                        query,
                        results,
                    )

                    if summary:
                        return clean_text(
                            getattr(
                                summary,
                                "response",
                                summary,
                            )
                        )

                except TypeError:

                    try:

                        summary = summarize(
                            results
                        )

                        if summary:
                            return clean_text(
                                getattr(
                                    summary,
                                    "response",
                                    summary,
                                )
                            )

                    except Exception:
                        pass

                except Exception:
                    pass

        formatter = getattr(
            web,
            "format_results",
            None,
        )

        if callable(formatter):
            return clean_text(
                formatter(results)
            )

        return clean_text(
            str(results)
        )

    except Exception as exc:

        log(
            "WEB ERROR: "
            + traceback.format_exc()
        )

        return (
            f"Minh gặp lỗi khi tìm web: {exc}"
        )


# ============================================================
# WEB CONTEXT HANDLER
# ============================================================

def handle_web_context(
    message: str,
    decision: Any = None,
    **kwargs: Any,
) -> str:

    if web_context is None:
        return (
            "Web Context chưa được tải."
        )

    try:

        source_number = None

        if decision is not None:

            if isinstance(
                decision,
                dict,
            ):
                source_number = decision.get(
                    "source_number"
                )
            else:
                source_number = getattr(
                    decision,
                    "source_number",
                    None,
                )

        if source_number is None:

            match = re.search(
                r"(?:nguồn|source|kết quả|result|cái)\s*#?\s*(\d+)",
                clean_text(message).lower(),
            )

            if match:
                source_number = int(
                    match.group(1)
                )

        if source_number is not None:

            getter = getattr(
                web_context,
                "get_source",
                None,
            )

            if callable(getter):

                source = getter(
                    int(source_number)
                )

                if source:

                    formatter = getattr(
                        web_context,
                        "format_source",
                        None,
                    )

                    if callable(formatter):
                        return clean_text(
                            formatter(source)
                        )

                    return clean_text(
                        str(source)
                    )

        current = getattr(
            web_context,
            "current_context",
            None,
        )

        if callable(current):

            value = current()

            if value:
                return clean_text(
                    str(value)
                )

        return (
            "Minh chưa xác định được nguồn "
            "mà Lam đang nhắc tới."
        )

    except Exception as exc:

        log(
            "WEB CONTEXT ERROR: "
            + repr(exc)
        )

        return (
            "Minh chưa lấy được ngữ cảnh nguồn web."
        )


