def ollama_chat(
    message: str,
    context: str = "",
) -> str:

    message = clean_text(message)

    if not message:
        return ""

    try:

        import json as _json
        from urllib.request import (
            Request,
            urlopen,
        )

        ollama_config = CONFIG.get(
            "ollama",
            {},
        )

        host = str(
            ollama_config.get(
                "host",
                "http://127.0.0.1:11434",
            )
        ).rstrip("/")

        model = str(
            ollama_config.get(
                "model",
                "qwen3:4b",
            )
        )

        timeout = int(
            ollama_config.get(
                "timeout",
                120,
            )
        )

        system_prompt = (
            "Bạn là MINH MINI, trợ lý cá nhân của Lam. "
            "Trả lời tự nhiên, chính xác, ngắn gọn khi câu hỏi đơn giản. "
            "Không được tự nhận đã mở, đóng, chạy hoặc thực hiện "
            "một hành động trên máy tính nếu hệ thống chưa cung cấp "
            "kết quả thực thi thành công. "
            "Nếu thiếu thông tin quan trọng, hãy nói rõ điều còn thiếu."
        )

        if context:
            system_prompt += (
                "\n\nNgữ cảnh cuộc trò chuyện hiện tại:\n"
                + context
            )

        payload = {
            "model": model,
            "messages": [
                {
                    "role": "system",
                    "content": system_prompt,
                },
                {
                    "role": "user",
                    "content": message,
                },
            ],
            "stream": False,
            "options": {
                "temperature": float(
                    ollama_config.get(
                        "temperature",
                        0.3,
                    )
                ),
            },
        }

        request = Request(
            host + "/api/chat",
            data=_json.dumps(
                payload,
                ensure_ascii=False,
            ).encode("utf-8"),
            headers={
                "Content-Type":
                    "application/json",
            },
            method="POST",
        )

        with urlopen(
            request,
            timeout=timeout,
        ) as response:

            raw = response.read().decode(
                "utf-8",
                errors="replace",
            )

        data = _json.loads(raw)

        answer = data.get(
            "message",
            {},
        ).get(
            "content",
            "",
        )

        return clean_text(answer)

    except Exception as exc:

        log(
            "OLLAMA ERROR: "
            + repr(exc)
        )

        return ""


